# Origin of the ADL backend, baked into the build (no trailing slash, no /api path).
#   Customer LAN server behind Caddy:  https://192.168.1.50:5443   (use the real reserved IP)
#   Local development:                 http://localhost:5000
#   Same-origin hosting:               leave empty
REACT_APP_API_URL=

# Optional per-service overrides (normally leave unset; they take priority over REACT_APP_API_URL)
# REACT_APP_PROCESS_URL=
# REACT_APP_AUTH_URL=
# REACT_APP_DEPARTMENT_URL=
# REACT_APP_PRODUCT_URL=
